APP_NAME=Invent
APP_ENV=local
APP_KEY=base64:8PnddzjE1+vsUUDmkb1V+s73tZ5ZwV03/76eefBViOM=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# LOCAL database (portable MySQL in ~/local-mysql). Server settings are saved in .env.server.bak
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_local
DB_USERNAME=invent
DB_PASSWORD=

# File-based drivers so the app can boot without extra services
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

SESSION_COOKIE=invent_local_session

