# Ignore environment files
/.env
/.env.example
/docker-compose.override.yml
/Dockerfile.local

# Never commit SSH private keys / local tunnel secrets
*.pem
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.id_rsa
*.id_ed25519
/scripts/**/*.pem
/scripts/**/id_*
/scripts/.ssh/

# Ignore Google credentials
/storage/app/google-credentials.json

# Ignore vendor and node_modules
/vendor
/node_modules

# Attendance desktop agent (Electron build output + dependencies)
/attendance-agent/node_modules/
/attendance-agent/dist/

# Ignore compiled files
/public/downloads/*.exe
/public/downloads/*.blockmap
/public/storage
/public/images/products
/public/uploads/tasks/*
!/public/uploads/tasks/.gitkeep
/storage/*.log
/storage/oauth-private.key
/storage/oauth-public.key
/storage/debugbar
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
/database/database.sqlite

# Ignore IDE and system files
.idea
.vscode
.DS_Store
Thumbs.db

# One-off local/dev SSH deploy, probe, and test scripts (production cron workers stay tracked)
/scripts/ssh-*.php
/scripts/test-*.php
/scripts/macy-*.php
/scripts/patch-*.php
/scripts/probe-*.php
/scripts/inspect-*.php
/scripts/compare-*.php
/scripts/audit-*.php
/scripts/clone-*.php
/scripts/dump-*.php
/scripts/ae-*.php
/scripts/check-*.php
/scripts/fix-*.php
vendor/symfony/polyfill-php83/Php83.php
.htaccess
composer.lock
