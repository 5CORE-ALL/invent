{
  "manifest_version": 3,
  "name": "LQS Amazon mobile view",
  "version": "1.0",
  "description": "Lets the LQS Mobile button open an Amazon product as a phone. Amazon ignores a narrow window and keeps the desktop page unless the request says it is a phone.",
  "key": "",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs", "windows"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://inventory.5coremanagement.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
