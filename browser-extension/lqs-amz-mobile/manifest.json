{
  "manifest_version": 3,
  "name": "LQS Amazon mobile view",
  "version": "1.4",
  "description": "Lets the LQS Mobile button open an Amazon, Newegg, Alibaba, or Temu product as a phone, and opens Temu on the US store.",
  "key": "",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "tabs", "windows", "cookies"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.ca/*",
    "*://*.newegg.com/*",
    "*://*.alibaba.com/*",
    "*://*.temu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://inventory.5coremanagement.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
